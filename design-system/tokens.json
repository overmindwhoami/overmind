{
  "$description": "Overmind design tokens derived from the projects.bizar.ro reference (see docs/reference-bizarro). Three levels: primitive -> semantic -> component. W3C Design Tokens (DTCG) format.",
  "primitive": {
    "color": {
      "grey-0": { "$type": "color", "$value": "#000000" },
      "grey-11": { "$type": "color", "$value": "#0b0b0b" },
      "grey-12": { "$type": "color", "$value": "#0c0c0d" },
      "grey-22": { "$type": "color", "$value": "#161616" },
      "grey-26": { "$type": "color", "$value": "#1a1a1a" },
      "grey-29": { "$type": "color", "$value": "#1d1d1f" },
      "grey-32": { "$type": "color", "$value": "#202020" },
      "grey-74": { "$type": "color", "$value": "#4a4a4f" },
      "grey-85": { "$type": "color", "$value": "#555555" },
      "grey-142": { "$type": "color", "$value": "#8e8e91" },
      "grey-154": { "$type": "color", "$value": "#9a9a9a" },
      "grey-157": { "$type": "color", "$value": "#9d9d9f" },
      "grey-185": { "$type": "color", "$value": "#b9b9bb" },
      "grey-207": { "$type": "color", "$value": "#cfcfcf" },
      "grey-227": { "$type": "color", "$value": "#e3e3e5" },
      "grey-232": { "$type": "color", "$value": "#e8e8e8" },
      "grey-236": { "$type": "color", "$value": "#ececec" },
      "grey-240": { "$type": "color", "$value": "#f0f0f0" },
      "grey-242": { "$type": "color", "$value": "#f2f2f2" },
      "grey-244": { "$type": "color", "$value": "#f4f4f4" },
      "grey-255": { "$type": "color", "$value": "#ffffff" },
      "paper-warm": { "$type": "color", "$value": "#efede7" },
      "paper-cream": { "$type": "color", "$value": "#f1efe9" }
    },
    "opacity": {
      "text-secondary": { "$type": "number", "$value": 0.451 },
      "hud-line": { "$type": "number", "$value": 0.85 },
      "hud-shadow": { "$type": "number", "$value": 0.7 },
      "hud-flash": { "$type": "number", "$value": 0.85 },
      "hud-ascii-wash": { "$type": "number", "$value": 0.55 },
      "hud-tracking": { "$type": "number", "$value": 0.7 },
      "hud-connection-dashed": { "$type": "number", "$value": 0.4 },
      "hud-connection-solid": { "$type": "number", "$value": 0.22 },
      "hud-outline-faint": { "$type": "number", "$value": 0.35 },
      "spotlight-dim": { "$type": "number", "$value": 0.78 },
      "list-row-base": { "$type": "number", "$value": 0.5 },
      "list-row-step": { "$type": "number", "$value": 0.07 },
      "list-row-floor": { "$type": "number", "$value": 0.08 }
    },
    "font": {
      "family-sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "family-mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "Consolas", "monospace"] },
      "size-8": { "$type": "dimension", "$value": "8px" },
      "size-11": { "$type": "dimension", "$value": "11px" },
      "size-13": { "$type": "dimension", "$value": "13px" },
      "size-14": { "$type": "dimension", "$value": "14px" },
      "weight-regular": { "$type": "fontWeight", "$value": 400 },
      "weight-medium": { "$type": "fontWeight", "$value": 500 },
      "weight-semibold": { "$type": "fontWeight", "$value": 600 },
      "line-20": { "$type": "dimension", "$value": "20px" },
      "line-22": { "$type": "dimension", "$value": "22px" },
      "tracking-tight": { "$type": "dimension", "$value": "-0.2px" }
    },
    "dimension": {
      "2": { "$type": "dimension", "$value": "2px" },
      "6": { "$type": "dimension", "$value": "6px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "22": { "$type": "dimension", "$value": "22px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "28": { "$type": "dimension", "$value": "28px" },
      "measure-325": { "$type": "dimension", "$value": "325px" },
      "measure-400": { "$type": "dimension", "$value": "400px" },
      "measure-420": { "$type": "dimension", "$value": "420px" }
    },
    "breakpoint": {
      "compact-max": { "$type": "dimension", "$value": "640px", "$description": "The reference's only breakpoint: (width <= 640px)" }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "10ms" },
      "flash": { "$type": "duration", "$value": "90ms" },
      "pop": { "$type": "duration", "$value": "140ms" },
      "leave": { "$type": "duration", "$value": "250ms" },
      "short": { "$type": "duration", "$value": "300ms" },
      "row": { "$type": "duration", "$value": "400ms" },
      "stagger-max": { "$type": "duration", "$value": "450ms" },
      "draw": { "$type": "duration", "$value": "500ms" },
      "ui": { "$type": "duration", "$value": "600ms" },
      "loop": { "$type": "duration", "$value": "900ms" },
      "reveal": { "$type": "duration", "$value": "1200ms" }
    },
    "easing": {
      "expo-out": { "$type": "cubicBezier", "$value": [0.19, 1, 0.22, 1] },
      "ease": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] },
      "ease-in-out": { "$type": "cubicBezier", "$value": [0.42, 0, 0.58, 1] },
      "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] },
      "damp": { "$type": "cubicBezier", "$value": [0.15, 0.68, 0.32, 1], "$description": "CSS stand-in for x += (target-x)(1-e^(-k·dt)) over 4.6/k s (99% settle), max error 0.4%" }
    },
    "damping": {
      "k-world": { "$type": "number", "$value": 3, "$description": "Camera height, pointer, focus glide. 95% in 1.0 s" },
      "k-mechanism": { "$type": "number", "$value": 4, "$description": "Spin brake, turn-to-face, audio rate. 95% in 0.75 s" },
      "k-overlay": { "$type": "number", "$value": 6, "$description": "Spotlight dim, pointer-speed meter" },
      "k-proximity": { "$type": "number", "$value": 10, "$description": "HUD box focus near cursor" },
      "k-instrument": { "$type": "number", "$value": 14, "$description": "Cursor reticle state. 95% in 0.21 s" },
      "decay-inertia": { "$type": "number", "$value": 1.1, "$description": "Spin boost after flick / key. Half-life 0.63 s" },
      "decay-drag-hold": { "$type": "number", "$value": 6 },
      "decay-pointer-idle": { "$type": "number", "$value": 4 }
    }
  },
  "semantic": {
    "color": {
      "ground": { "$type": "color", "$value": "{primitive.color.grey-0}" },
      "text-primary": { "$type": "color", "$value": "{primitive.color.grey-242}" },
      "text-secondary": { "$type": "color", "$value": "rgba(242, 242, 242, 0.451)" },
      "focus-ring": { "$type": "color", "$value": "currentColor" },
      "hud-ink": { "$type": "color", "$value": "{primitive.color.grey-255}" },
      "hud-line": { "$type": "color", "$value": "rgba(236, 236, 236, 0.85)" },
      "hud-under-stroke": { "$type": "color", "$value": "rgba(0, 0, 0, 0.7)" },
      "hud-flash": { "$type": "color", "$value": "rgba(255, 255, 255, 0.85)" },
      "spotlight": { "$type": "color", "$value": "rgba(0, 0, 0, 0.78)" },
      "signal": { "$type": "color", "$value": "content", "$description": "Hue exists only as content (the work itself) inside the instrument layer. The world layer is rendered at saturation 0." }
    },
    "typography": {
      "ui": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family-sans}", "fontSize": "{primitive.font.size-14}", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "{primitive.font.tracking-tight}" } },
      "ui-paragraph": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family-sans}", "fontSize": "{primitive.font.size-14}", "fontWeight": 400, "lineHeight": "{primitive.font.line-20}", "letterSpacing": "{primitive.font.tracking-tight}" } },
      "ui-list": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family-sans}", "fontSize": "{primitive.font.size-14}", "fontWeight": 400, "lineHeight": "{primitive.font.line-22}", "letterSpacing": "{primitive.font.tracking-tight}" } },
      "hud-title": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family-sans}", "fontSize": "{primitive.font.size-13}", "fontWeight": 600, "lineHeight": "normal", "letterSpacing": "0px", "textTransform": "uppercase" } },
      "hud-label": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family-sans}", "fontSize": "{primitive.font.size-11}", "fontWeight": 500, "lineHeight": "normal", "letterSpacing": "0px" } },
      "hud-micro": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.family-mono}", "fontSize": "{primitive.font.size-8}", "fontWeight": 600, "lineHeight": "normal", "letterSpacing": "0px" } }
    },
    "space": {
      "gutter": { "$type": "dimension", "$value": "{primitive.dimension.24}", "$description": "16px at <= 640px" },
      "gutter-compact": { "$type": "dimension", "$value": "{primitive.dimension.16}" },
      "row": { "$type": "dimension", "$value": "{primitive.dimension.22}", "$description": "Logo height = list row height" },
      "measure-copy": { "$type": "dimension", "$value": "{primitive.dimension.measure-400}" },
      "measure-copy-compact": { "$type": "dimension", "$value": "{primitive.dimension.measure-325}" }
    },
    "motion": {
      "scene-reveal": { "$type": "transition", "$value": { "duration": "{primitive.duration.reveal}", "delay": "0ms", "timingFunction": "{primitive.easing.ease}" } },
      "chrome-reveal": { "$type": "transition", "$value": { "duration": "{primitive.duration.reveal}", "delay": "600ms", "timingFunction": "{primitive.easing.ease}" } },
      "ui-affordance": { "$type": "transition", "$value": { "duration": "{primitive.duration.ui}", "delay": "0ms", "timingFunction": "{primitive.easing.expo-out}" } },
      "list-row": { "$type": "transition", "$value": { "duration": "{primitive.duration.row}", "delay": "0ms", "timingFunction": "{primitive.easing.ease}" } },
      "hud-leave": { "$type": "transition", "$value": { "duration": "{primitive.duration.leave}", "delay": "0ms", "timingFunction": "{primitive.easing.linear}" } }
    }
  },
  "component": {
    "link": {
      "underline-thickness": { "$type": "dimension", "$value": "1px" },
      "underline-transition": { "$type": "transition", "$value": "{semantic.motion.ui-affordance}" },
      "underline-origin-in": { "$type": "string", "$value": "left" },
      "underline-origin-out": { "$type": "string", "$value": "right" },
      "focus-outline-width": { "$type": "dimension", "$value": "1px" },
      "focus-outline-offset": { "$type": "dimension", "$value": "{primitive.dimension.6}" }
    },
    "sound-toggle": {
      "hit-size": { "$type": "dimension", "$value": "{primitive.dimension.28}" },
      "hit-margin": { "$type": "dimension", "$value": "-6px" },
      "bar-width": { "$type": "dimension", "$value": "{primitive.dimension.2}" },
      "bar-gap": { "$type": "dimension", "$value": "{primitive.dimension.2}" },
      "bar-height": { "$type": "dimension", "$value": "12px" },
      "idle-scale": { "$type": "number", "$value": 0.2 },
      "reduced-scale": { "$type": "number", "$value": 0.7 },
      "loop": { "$type": "duration", "$value": "{primitive.duration.loop}" },
      "phase-offsets": { "$type": "string", "$value": "0s, -0.45s, -0.2s, -0.7s" },
      "focus-outline-offset": { "$type": "dimension", "$value": "{primitive.dimension.2}" }
    },
    "index-nav": {
      "width": { "$type": "dimension", "$value": "min(420px, 100% - 48px)" },
      "height": { "$type": "dimension", "$value": "286px", "$description": "13 rows of 22" },
      "active-offset": { "$type": "dimension", "$value": "132px", "$description": "6 rows: active row centred" },
      "mask": { "$type": "string", "$value": "linear-gradient(transparent, #000 28% 72%, transparent)" },
      "row-opacity": { "$type": "string", "$value": "max(0.08, 0.5 - distance * 0.07); active = 1" },
      "scroll-transition": { "$type": "transition", "$value": "{semantic.motion.ui-affordance}" }
    },
    "hud": {
      "stroke": { "$type": "dimension", "$value": "1px" },
      "under-stroke": { "$type": "dimension", "$value": "3px" },
      "text-shadow-blur": { "$type": "dimension", "$value": "3px" },
      "corner-marker": { "$type": "dimension", "$value": "4px" },
      "bracket-arm": { "$type": "dimension", "$value": "7px" },
      "box-scale": { "$type": "number", "$value": 0.8, "$description": "Measurement boxes drawn at 80% of their feature (case outline stays 100%); reference 1" },
      "proximity-grow": { "$type": "number", "$value": 0.06, "$description": "Box growth near the cursor; reference 0.18" },
      "compact-below": { "$type": "dimension", "$value": "768px", "$description": "Viewport width below which the instrument is compact" },
      "compact-box-scale": { "$type": "number", "$value": 0.68 },
      "compact-boxes": { "$type": "number", "$value": 12 },
      "compact-labels": { "$type": "number", "$value": 4, "$description": "Boxes that keep coordinate readouts when compact" },
      "compact-rings": { "$type": "string", "$value": "3–5" },
      "min-fill-box": { "$type": "dimension", "$value": "30px" },
      "skip-fill-below": { "$type": "dimension", "$value": "18px" },
      "ascii-cell": { "$type": "dimension", "$value": "8px" },
      "ascii-ramp": { "$type": "string", "$value": " ·/×□▣" },
      "proximity-radius": { "$type": "dimension", "$value": "120px" },
      "tracking-radius": { "$type": "dimension", "$value": "240px" }
    },
    "reticle": {
      "radius": { "$type": "string", "$value": "7 + 4n + sin(6t)(1 + max(n,0)) px" },
      "tick-gap": { "$type": "string", "$value": "2 + 2·max(n,0) px" },
      "tick-length": { "$type": "string", "$value": "5 - 2·min(n,0) px" },
      "spin": { "$type": "string", "$value": "0.6 + 2.4·max(n,0) rad/s" },
      "state-rate": { "$type": "number", "$value": "{primitive.damping.k-instrument}" }
    }
  }
}
