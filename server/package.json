{
  "name": "overmind-archivist",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The Overmind: reads the internet's memory every minute, writes what it keeps onto floppy disks, seals them.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "round": "tsx src/cli.ts",
    "chain": "tsx src/chain-cli.ts",
    "genesis": "node scripts/build-genesis.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@aws-sdk/client-s3": "3.1148.0",
    "@solana/web3.js": "1.98.4",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
