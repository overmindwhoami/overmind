{
  "name": "overmind-archivist",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The Overmind: reads the internet's memory every minute, writes what it keeps onto floppy disks, seals them.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "round": "tsx src/cli.ts",
    "chain": "tsx src/chain-cli.ts",
    "genesis": "node scripts/build-genesis.mjs",
    "lp:lut": "tsx scripts/lp-lut.ts",
    "lp:rehearse": "tsx scripts/lp-rehearse.ts",
    "lp": "tsx scripts/lp.ts",
    "preflight": "tsx scripts/preflight.ts",
    "lenses": "tsx scripts/lenses.ts",
    "rpc:check": "tsx scripts/rpc-check.ts",
    "claude:check": "tsx scripts/claude-check.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.34.4",
    "@anthropic-ai/sdk": "0.132.1",
    "@aws-sdk/client-s3": "3.1148.0",
    "@pump-fun/pump-sdk": "2.0.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
